# ── Vertex AI / Google Cloud ──────────────────────────────────────────────────
# Your Google Cloud project ID
VERTEX_PROJECT_ID="your-gcp-project-id"

# Vertex AI region (e.g. us-central1, global)
VERTEX_LOCATION="global"

# ── Gemini API Key (leave blank when using Vertex AI with a service account) ──
# Only needed if NOT using Vertex AI / service account
GEMINI_API_KEY=""

# ── Service Account Credentials ───────────────────────────────────────────────
# Copy these from your Google Cloud service account JSON key file.
# This avoids committing any .json key file to the repository.
GOOGLE_SA_TYPE="service_account"
GOOGLE_SA_PROJECT_ID="your-gcp-project-id"
GOOGLE_SA_PRIVATE_KEY_ID="your-private-key-id"
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SA_CLIENT_ID="your-client-id"
GOOGLE_SA_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
GOOGLE_SA_TOKEN_URI="https://oauth2.googleapis.com/token"
GOOGLE_SA_AUTH_PROVIDER_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
GOOGLE_SA_CLIENT_CERT_URL="https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com"
GOOGLE_SA_UNIVERSE_DOMAIN="googleapis.com"

# ── Custom Path Overrides (Optional) ──────────────────────────────────────────
# Path to a folder containing ffmpeg and ffprobe binaries (e.g. C:\ffmpeg\bin)
# FFMPEG_PATH=""

